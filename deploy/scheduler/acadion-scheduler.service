[Unit]
Description=Acadion — despachador de tareas programadas
After=network.target mysql.service

[Service]
Type=oneshot

# El usuario del servidor web, NO root: las tareas escriben en storage/ y
# generan archivos que luego tiene que poder leer PHP-FPM. Corriéndolo como
# root, esos archivos quedan con dueño equivocado y la aplicación empieza a
# fallar con «permission denied» en sitios que no tienen que ver con el cron.
User=www-data
Group=www-data

WorkingDirectory=/var/www/acadion
ExecStart=/usr/bin/php /var/www/acadion/artisan schedule:run

# Que un fallo no arrastre al timer: si una tarea revienta, la siguiente
# corrida vuelve a intentarlo por su cuenta.
SuccessExitStatus=0 1

# ── Sin esta línea, systemd mata todo lo que el despachador acaba de lanzar ──
#
# Todas las tareas de Acadion se declaran con `runInBackground()`: Laravel las
# arranca con `&` y `schedule:run` vuelve enseguida. Con un servicio `oneshot` y
# el modo de terminación por omisión (control-group), systemd da la unidad por
# acabada en cuanto ese proceso sale y limpia el cgroup — o sea que manda SIGTERM
# a los hijos recién lanzados.
#
# El síntoma es exactamente el que este archivo existe para evitar: nada falla,
# nada se registra, y las tareas simplemente no ocurren. Con el trabajador de la
# cola —que puede estar hasta 55 segundos procesando, o bajando un video de
# 600 MB— es todavía más visible: se lo lleva a mitad del trabajo.
#
# Con `process` sólo se termina el proceso principal y los hijos siguen su curso.
# `withoutOverlapping` es lo que impide que se apilen.
KillMode=process
