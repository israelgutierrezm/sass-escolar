<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- La suite arranca la aplicacion muchas veces y registra el archivo de
             rutas entero en cada arranque, asi que su pico crece con el tamano
             del sistema, no con el numero de pruebas. Con los 128M del php.ini
             la suite completa reventaba con "Allowed memory size exhausted"
             cargando routes/tenant.php, y el fallo no senalaba a la prueba
             culpable: moria la que tocara pasar en ese momento.

             Va aqui y no en el php.ini de la maquina para que el limite viaje
             con el proyecto: si no, el error reaparece en cuanto alguien clona
             el repositorio. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Las pruebas del esquema de una escuela corren en MySQL: las
             migraciones de tenant estan escritas contra MySQL y en SQLite
             abortan. Ver Tests\TenantTestCase. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="acadion_testing"/>
        <env name="CENTRAL_DB_DATABASE" value="acadion_testing_central"/>
        <env name="TENANCY_CENTRAL_CONNECTION" value="central"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
